ading_blurb":"rgba(0,0,0,0)","color_description":"rgba(0,0,0,0)","color_svg":"rgba(0,0,0,0)","color_counter":"#142c73","background":"color","color_background":"#deefff","gradient":"","image_overlay_opacity":0,"image_overlay_color":"rgba(0,0,0,0)","image_overlay_opacity_mobile":0,"image_overlay_color_mobile":"rgba(0,0,0,0)","imagealign":"center","imagesize":"cover","background_width":"content_width","background_spacing":"normal","remove_bottom_spacing":false}},"reviews_EMnUrG":{"type":"reviews","blocks":{"review_WjLknp":{"type":"review","settings":{"show_image":"show","image":"shopify://shop_images/9022a705161ff42b7879d88f1fd6d0e8_44dbe5b9-63c5-4682-8a1c-c3daf7a20f89.png","url":"","heading":"Отлична храна за кучета! 🐕","description":"<p>⭐️⭐️⭐️⭐️⭐️ Невероятен продукт! Моят Макс е толкова енергичен и здрав откакто преминахме на вашата храна за кучета. Козината му е блестяща, а храносмилането е перфектно. Препоръчвам го на всички мои приятели с кучета! 🐾</p>","author":"— Мария Петрова"}},"review_G6WrQd":{"type":"review","settings":{"show_image":"show","image":"shopify://shop_images/9022a705161ff42b7879d88f1fd6d0e8_46259261-ad20-4539-a750-93a984edfcd3.png","url":"","heading":"Котката ми го обожава! 🐱","description":"<p>⭐️⭐️⭐️⭐️⭐️ Най-добрата храна за котки, който съм пробвала! Мисис Уискърс е толкова разборчива, но тази храна я прави щастлива всеки ден. Качеството е видимо в козината и енергията й. Благодаря! 💛</p>","author":"— Елена Иванова"}},"review_fQVfKW":{"type":"review","settings":{"show_image":"show","image":"shopify://shop_images/9022a705161ff42b7879d88f1fd6d0e8.png","url":"","heading":"Здравословен избор за моето куче! 💪","description":"<p>⭐️⭐️⭐️⭐️⭐️ Преминахме на тази храна поради алергиите на Дизел и резултатите са фантастични! Без изкуствени добавки, само натурални съставки. Ветеринарът ми каза, че здравето му се е подобрило значително. Топ избор! 👍</p>","author":"— Иван Георгиев"}},"review_iViqUT":{"type":"review","settings":{"show_image":"show","image":"shopify://shop_images/9022a705161ff42b7879d88f1fd6d0e8_fc9dcf6d-32b7-4027-9bc2-e58ef79882ab.png","url":"","heading":"Перфектна храна за котки! ✨","description":"<p>⭐️⭐️⭐️⭐️⭐️ Харли е толкова разборчива, но тази храна е нейната любима! Козината й е мека и блестяща, а енергията й е невероятна. Препоръчвам го на всички котки собственици. Качеството е несравнимо! 🐾</p>","author":"— Софи Николова"}}},"block_order":["review_WjLknp","review_G6WrQd","review_fQVfKW","review_iViqUT"],"settings":{"subheading":"","heading":"Мнения от наши клиенти 🐶","heading_aligment":"text-center","top_spacing":"normal","width":"page-width","grid":"col-md-6 col-3","swipe_on_mobile":true,"image_ratio":"1, round-image","texts_aligment":"text-center","description_size":"body2","color_subheading":"rgba(0,0,0,0)","color_heading":"rgba(0,0,0,0)","color_swipe_buttons":"rgba(0,0,0,0)","color_heading_blurb":"rgba(0,0,0,0)","color_description":"rgba(0,0,0,0)","color_author":"rgba(0,0,0,0)","background":"hide","color_background":"#ddf1f0","gradient":"","image_overlay_opacity":0,"image_overlay_color":"rgba(0,0,0,0)","image_overlay_opacity_mobile":0,"image_overlay_color_mobile":"rgba(0,0,0,0)","imagealign":"center","imagesize":"cover","background_width":"fullwidth","background_spacing":"normal","remove_bottom_spacing":false}},"accordion_PcWKtk":{"type":"accordion","blocks":{"text_yTTYXW":{"type":"text","settings":{"heading":"Предлагате ли доставка в същия ден?","description":"<p>Да! Поръчките, направени преди 14:00, имат право на доставка в същия ден в рамките на града.</p>"}},"text_LeaTCk":{"type":"text","settings":{"heading":"Вашите храни за домашни любимци одобрени ли са от ветеринари?","description":"<p>Абсолютно. Всички наши храни идват от надеждни марки и отговарят на ветеринарните стандарти за безопасност и качество.</p>"}},"text_9LkbPf":{"type":"text","settings":{"heading":"Мога ли да върна артикул, ако на моя домашен любимец не му харесва?","description":"<p>Да, можете да върнете или замените неизползвани артикули в рамките на 14 дни. Просто запазете оригиналната опаковка.</p>"}},"text_kRWRzi":{"type":"text","settings":{"heading":"Продавате ли продукти за всички видове домашни любимци?","description":"<p>Предлагаме стоки за кучета, котки, птици, риби, влечуги и малки животни — всичко на едно място.</p>"}},"text_gWtwxx":{"type":"text","settings":{"heading":"Как мога да проследя моята поръчка?","description":"<p>След завършване на покупката ще получите линк за проследяване по имейл или SMS, за да можете да следите поръчката си в реално време.</p>"}}},"block_order":["text_yTTYXW","text_LeaTCk","text_9LkbPf","text_kRWRzi","text_gWtwxx"],"name":"t:sections.accordion.presets.name","settings":{"show_all_text_in_admin":true,"subheading":"","heading":"Често задавани въпроси","heading_aligment":"text-center","top_spacing":"normal","width":"default","disable_accordion":false,"heading_tag":"h4","description_size":"body2","color_subheading":"rgba(0,0,0,0)","color_heading":"rgba(0,0,0,0)","color_heading_accordion":"rgba(0,0,0,0)","color_text":"rgba(0,0,0,0)","color_lines":"rgba(0,0,0,0)","background":"color","color_background":"rgba(0,0,0,0)","gradient":"","image_overlay_opacity":0,"image_overlay_color":"rgba(0,0,0,0)","image_overlay_opacity_mobile":0,"image_overlay_color_mobile":"rgba(0,0,0,0)","imagealign":"center","imagesize":"cover","background_width":"content_width","background_spacing":"normal","remove_bottom_spacing":false}},"1649695260dd6ece02":{"type":"ticker","settings":{"top_spacing":"normal","ticker_time":10,"direction":"ticker-to-left","text_size":"normal","url":"","text":"<p><strong>Безплатна доставка- </strong>на поръчки над 50 евро!</p>","show_icon":"svg","icon_name":"truck_sm","color_svg":"#142c73","color_text":"rgba(0,0,0,0)","background":"color","color_background":"#deefff","gradient":"","image_overlay_opacity":0,"image_overlay_color":"rgba(0,0,0,0)","image_overlay_opacity_mobile":0,"image_overlay_color_mobile":"rgba(0,0,0,0)","imagealign":"center","image